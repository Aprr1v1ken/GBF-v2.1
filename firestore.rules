rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny every collection that is not explicitly listed below.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'aprryviken@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function validId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && validId(adminId);
    }

    // A lightweight connectivity probe contains no church data.
    match /test/connection {
      allow read: if true;
    }

    // Public warta, agendas, and documentation may be read by visitors, but
    // only an authenticated church administrator can publish or alter them.
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin() && validId(announcementId);
    }
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin() && validId(scheduleId);
    }
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin() && validId(eventId);
    }
    match /activity_images/{imageId} {
      allow read: if true;
      allow create, update: if isAdmin() && validId(imageId)
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 1500000;
      allow delete: if isAdmin() && validId(imageId);
    }

    // Membership, contact, family, staff, and financial records are private.
    match /church_staff/{staffId} {
      allow read, write: if isAdmin() && validId(staffId);
    }
    match /members/{memberId} {
      allow read, write: if isAdmin() && validId(memberId);
    }
    match /families/{familyId} {
      allow read, write: if isAdmin() && validId(familyId);
    }
    match /financial_transactions/{txId} {
      allow read, write: if isAdmin() && validId(txId);
    }
    match /users/{userId} {
      allow read, write: if false;
    }
  }
}
